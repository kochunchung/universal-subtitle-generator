# 網頁版設定範例。複製成 .env 後修改(或執行「設定Google登入.bat」自動寫入)。
# .env 含有金鑰,不要分享、不要放進版本控制。

# 網站的埠號(port)。8780 被其他程式佔用時改這裡,WEB_PUBLIC_URL 也要改成同一個埠號;
# 改了之後,Google Cloud 的「已授權的重新導向 URI」要加上新網址(舊的那行可以留著)
WEB_PORT=8780
# 使用者在瀏覽器輸入的網址(Google 登入的回呼網址 = 這個網址 + /auth/google/callback)
WEB_PUBLIC_URL=http://localhost:8780

# 登入 Cookie 的簽署金鑰(隨機長字串;設定Google登入.bat 會自動產生)
WEB_SECRET_KEY=
# 加密使用者 API 金鑰的主金鑰(隨機長字串;設定Google登入.bat 會自動產生)。換掉或遺失後,所有人要重填金鑰
WEB_KEY_SECRET=

# Google 登入(Google Cloud → Google Auth Platform → 用戶端 → 網頁應用程式)
WEB_GOOGLE_CLIENT_ID=
WEB_GOOGLE_CLIENT_SECRET=

# 只允許這些信箱網域登入(逗號分隔);空白 = 不限制(目前的決定)
WEB_ALLOWED_EMAIL_DOMAINS=
# 另外允許的個別信箱(有設網域限制時才需要)
WEB_ALLOWED_EMAILS=
# 新帳號要不要管理者核准:1 = 需要(目前的決定),0 = 登入就能用
WEB_REQUIRE_APPROVAL=1
# 這些信箱登入後自動核准並成為管理者,可以在「管理」頁核准帳號、設定等級與個別權限(逗號分隔)
WEB_ADMIN_EMAILS=

# 各項上限(檔案大小、每天時數、空間、保存天數…)依會員等級決定,在網頁的「管理」頁設定,不寫在這裡。
# 一般會員的工作等超過幾分鐘,就不再被付費會員插隊
WEB_PRIORITY_MAX_WAIT_MIN=30
# 「每天」以哪個時區的午夜歸零(台灣 = 8)
WEB_TZ_OFFSET_HOURS=8

# 開發用登入(輸入任何名稱就能登入)。正式上線一定要是 0
WEB_DEV_LOGIN=0

# 存 API 金鑰前先向 Anthropic / OpenAI 確認金鑰有效(伺服器要能連外)。1 = 要(建議),0 = 不確認
WEB_KEY_CHECK=1
# 驗收用:保存天數的「1 天」是幾秒。正式使用時刪掉這行(預設 86400 = 真的一天)
# WEB_DAY_SECONDS=60
